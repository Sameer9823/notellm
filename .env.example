# --- Database (Neon Postgres) ---
# Pooler URL (recommended for app connections) and direct URL (for Prisma DDL/db:push).
DATABASE_URL="postgresql://user:password@host-pooler.c-1.aws.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host.c-1.aws.neon.tech/db?sslmode=require"

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Webhook secret for Clerk user.* events (user.deleted, user.updated).
# Get from Clerk Dashboard → Webhooks → Signing Secret.
CLERK_WEBHOOK_SECRET="whsec_..."

# --- Vector DB (Qdrant) ---
QDRANT_URL="https://xxxx.qdrant.io"
QDRANT_API_KEY=""
QDRANT_COLLECTION="footnote_chunks"
# Separate Qdrant collection for semantic long-term memory (src/lib/memory.ts).
# Optional — defaults to "user_memories" if unset.
QDRANT_MEMORY_COLLECTION=""

# --- Cache / job status (Redis) ---
REDIS_URL="redis://localhost:6379"

# --- LLM / embeddings / TTS (OpenAI) ---
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TTS_MODEL="tts-1"

# --- Optional source ingestion helpers ---
SEARCHAPI_API_KEY=""
YT_PROXY_URL=""

# --- Optional: Firecrawl (URL extractor) ---
# Used as the primary URL-source extractor when set: renders JS and gets
# past most bot-detection/Cloudflare walls that a plain fetch can't. Falls
# back to the original fetch + Readability extractor when unset or on
# failure, so URL sources keep working either way.
# (Single declaration — no duplicate entry elsewhere.)

# --- Tavily (src/lib/tavily.ts) ---
# Powers the "Web Search" source tile: search a topic, pick results, add
# them as normal URL sources. Leave blank to hide/disable that tile's
# search from actually finding anything (the UI still shows it).
TAVILY_API_KEY=""
# Public companion to TAVILY_API_KEY — set to "true" when Tavily is enabled so
# the client can conditionally register the search_web voice tool. Both must
# be set together.
NEXT_PUBLIC_TAVILY_ENABLED=""

# --- Cloudinary (src/lib/cloudinary.ts) ---
# Optional binary storage for original PDF uploads and generated podcast
# MP3s, keeping them out of Postgres. Leave all three blank to keep the
# original behavior (PDFs base64'd into a text column transiently, MP3s
# stored as bytes in AudioOverview.audioData) — nothing else changes.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Cloudinary (browser direct upload) ---
# Used by the browser to upload PDFs directly to Cloudinary via signed upload
# (avoids Vercel's ~4.5MB request-body limit). These MUST be NEXT_PUBLIC_
# because the client reads them.
# Cloud name (e.g., "sthv3md8")
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# API Key (e.g., "622773965817544") - used for signed browser uploads
NEXT_PUBLIC_CLOUDINARY_API_KEY=""

# --- Liveness / readiness probes ---
# Shared secret required by /api/health/ready (the heavier dependency check).
# The cheap /api/health liveness probe needs no token. Generate with:
#   openssl rand -hex 32
HEALTH_TOKEN=""

# Shared secret required by /api/debug/check diagnostic route.
# Generate with: openssl rand -hex 32
DEBUG_KEY=""

# Content-Security-Policy starts in Report-Only mode. Set to "true" to enforce
# (do this after monitoring reports for a week).
CSP_ENFORCE="false"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Free-tier credit window (src/lib/credits.ts) ---
CREDITS_MAX_PER_WINDOW=200
CREDITS_WINDOW_HOURS=6

# --- Billing (Stripe) ---
# Ported from sourcelm's billing feature: one-time credit packs +
# recurring subscriptions, layered on top of the free-tier window above.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price ids for the packs/plans defined in src/lib/billing-config.ts.
# Leave unset to disable a given pack/plan (checkout for it will 400).
STRIPE_PRICE_PACK_STARTER=""
STRIPE_PRICE_PACK_PRO=""
STRIPE_PRICE_PACK_POWER=""
STRIPE_PRICE_PLAN_PLUS=""
STRIPE_PRICE_PLAN_PRO=""

# --- Background jobs (Inngest) ---
# Source ingest, study-artifact generation, audio overview generation, and
# learning-roadmap generation all run as durable Inngest functions
# (src/lib/inngest/functions.ts) instead of fire-and-forget `after()` calls.
#
# Local dev: leave INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY EMPTY and set
# INNGEST_DEV=1. `npm run dev` starts NEXT on port 3000 and the locally
# installed `inngest-cli dev` (with --no-discovery, pointed at
# http://localhost:3000/api/inngest) in the same terminal. Open
# http://localhost:8288 to inspect the Apps / Runs tabs, or hit
# /api/dev/inngest-status for a JSON summary.
#
#   IMPORTANT: do NOT paste your Inngest Cloud event/signing keys into a local
#   .env — with them set, `inngest send()` talks to Inngest Cloud, which cannot
#   callback to your localhost app and so events sit in QUEUED forever.
#
# Production: set INNGEST_EVENT_KEY + INNGEST_SIGNING_KEY (from the Inngest
# dashboard) as Vercel project env vars and leave INNGEST_DEV unset.
# `npm run dev` for local development:
#   INNGEST_DEV=1
INNGEST_DEV=1
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Override the dev-server URL (default http://localhost:8288). Rarely needed;
# set it if you run the inngest dev server on a different host/port.
# INNGEST_DEVSERVER_URL="http://127.0.0.1:8288"

# --- Voice mode (Realtime API) ---
# Server-side only. The browser never receives OPENAI_API_KEY directly;
# /api/notebooks/[id]/voice/session mints a short-lived ephemeral client
# secret instead. Never prefix these with NEXT_PUBLIC_.
OPENAI_REALTIME_MODEL="gpt-realtime"
OPENAI_REALTIME_VOICE="marin"
OPENAI_BASE_URL="https://api.openai.com/v1"

# HMAC secret for signing tool tokens (userId + notebookId + sessionId).
# Required for voice mode. Generate with: openssl rand -base64 32
VOICE_TOKEN_SECRET=""
# Ephemeral token + client-secret TTL in seconds (10 minutes is the
# OpenAI-accepted minimum for Realtime client secrets).
VOICE_TOKEN_TTL_SECONDS=600

# --- Credits / abuse limits for voice ---
# Cost in credits per voice block, and block length in minutes.
VOICE_CREDIT_COST_PER_BLOCK=1
VOICE_CREDIT_BLOCK_MINUTES=5
# Client-side block timer mirrors the server-side block length so the UI
# re-mints before the current block expires. Must match or exceed
# VOICE_CREDIT_BLOCK_MINUTES.
NEXT_PUBLIC_VOICE_CREDIT_BLOCK_MINUTES=5
