{
  "name": "notebook-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered research assistant (NotebookLM-style) — multi-source RAG with citations.",
  "scripts": {
    "dev:next": "next dev",
    "dev:inngest": "node -e \"const p=process.env.PORT||3000;const r=require('child_process').spawnSync('inngest-cli',['dev','-u','http://localhost:'+p+'/api/inngest','--no-discovery'],{stdio:'inherit'});process.exitCode=r.status\"",
    "dev": "concurrently -n \"next,inngest\" \"npm run dev:next\" \"npm run dev:inngest\"",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepush": "npm run typecheck && npm test",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && patch-package",
    "prepare": "husky",
    "worker": "tsx src/worker/index.ts",
    "backfill:memory-vectors": "tsx scripts/backfill-memory-vectors.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.5.22",
    "@clerk/themes": "^2.4.57",
    "@mozilla/readability": "0.6.0",
    "@prisma/client": "6.2.1",
    "@qdrant/js-client-rest": "1.19.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "@xyflow/react": "^12.11.3",
    "bullmq": "5.34.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "4.1.0",
    "docx": "^9.12.0",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "framer-motion": "11.15.0",
    "inngest": "3.54.0",
    "ioredis": "5.4.2",
    "jsdom": "25.0.1",
    "lucide-react": "0.469.0",
    "marked": "^18.1.1",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "node-webvtt": "1.9.4",
    "openai": "4.79.1",
    "pdf-parse": "1.1.1",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "9.0.3",
    "react-pdf": "^11.0.0",
    "remark-gfm": "4.0.0",
    "samai-sdk": "0.3.6",
    "sonner": "1.7.1",
    "stripe": "18.0.0",
    "svix": "^2.8.0",
    "tailwind-merge": "2.6.0",
    "undici": "^8.12.1",
    "uuid": "^11.1.1",
    "youtube-transcript": "^1.3.1",
    "youtubei.js": "^17.2.0",
    "zod": "^3.25.28",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "0.5.15",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.12.0",
    "@types/pdf-parse": "1.1.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "10.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "10.4.20",
    "concurrently": "^10.0.6",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.1",
    "husky": "^9.1.7",
    "inngest-cli": "^1.46.0",
    "patch-package": "^8.0.1",
    "postcss": "8.5.1",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "bullmq": {
      "uuid": "^11.1.1"
    },
    "uuid": "^11.1.1",
    "@grpc/grpc-js": "^1.14.6",
    "brace-expansion": "^1.1.21",
    "qs": "^6.16.1",
    "ws": "^8.22.0",
    "undici": "^8.12.1"
  },
  "allowScripts": {
    "inngest-cli@1.46.0": true
  }
}
